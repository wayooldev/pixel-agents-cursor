{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixel Agents",
  "version": "0.1.0",
  "identifier": "hq.pixelagents.desktop",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pixel Agents",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["../resources/server"]
  },
  "plugins": {}
}
